{
	"tasks": [
		{
			"type": "shell",
			"label": "make",
			"command": "make",
			"args": [""],
			"problemMatcher": [],
		},
		{
			"type": "shell",
			"label": "make debug",
			"command": "make",
			"args": ["bDEBUG=1"],
			"problemMatcher": [],
		},
		{
			"type": "shell",
			"label": "make clean",
			"command": "make",
			"args": ["clean"],
			"problemMatcher": [],
		},
		{
			"type": "shell",
			"label": "make tools",
			"command": "make",
			"options": {
				"cwd": "tools/Utilety/"
			},
			"args": [""],
			"problemMatcher": [],
		},
		{
			"type": "shell",
			"label": "clean tools",
			"command": "make",
			"options": {
				"cwd": "tools/Utilety/"
			},
			"args": ["clean"],
			"problemMatcher": [],
		},
		{
			"type": "shell",
			"label": "cook assets",
			"command": "tools/Utilety/build/Utilety.exe",
			"args": [""],
			"problemMatcher": [],
			"dependsOn": ["make tools"],
		},
		{
			"type": "shell",
			"label": "clean assets",
			"windows":
			{
				"command": "del 'game/include/assets/*', 'game/source/assets/*', 'game/assets/asset_indexing', 'game/assets/sprites/*.pal', 'game/assets/backgrounds/*/*.pal'"
			},
			"linux":
			{
				"command": "rm game/include/assets/* game/source/assets/* game/assets/asset_indexing game/assets/sprites/*.pal game/assets/backgrounds/*/*.pal"
			},
			"problemMatcher": [],
		},
		{
			"type": "shell",
			"label": "mGBA",
			"windows":
			{
				"command": "Start-Process",
				"args":
				[
					"-FilePath",
					"${env:ProgramFiles}/mGBA/mGBA.exe",
					"-ArgumentList",
					"-g ${workspaceFolder}/Astrolabe.elf"
				]
			},
			"linux":
			{
				"command": "io.mgba.mGBA -g \"${workspaceFolder}/Astrolabe.elf\"",
			},
			"isBackground": true,
			"problemMatcher": {
				"pattern": [{ "regexp": ".", "file": 1, "location": 2, "message": 3 }],
				"background": {
					"activeOnStart": true,
					"beginsPattern": ".",
					"endsPattern": "."
				}
			}
		},
		{
			"label": "prep for debug",
			"dependsOrder": "sequence",
			"dependsOn": [
				"make debug",
				"mGBA"
			]
		}
	],
	"version": "2.0.0"
}