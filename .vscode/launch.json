{
	"configurations": [
		{
			"name": "Launch",
			"type": "cppdbg",
			"request": "launch",
			"targetArchitecture": "arm",
			"program": "${workspaceFolder}/Astrolabe.elf",
			"args": [],
			"stopAtEntry": false,
			"cwd": "${fileDirname}",
			"environment": [],
			"externalConsole": false,
			"windows":
			{
				"setupCommands":
				[
					{
						"text": "shell start /b \"\" \"${env:ProgramFiles}/mGBA/mGBA.exe\" -g \"${workspaceFolder}/Astrolabe.elf\""
					}
				]
			},
			"linux":
			{
				"setupCommands": [
					{
						"text": "shell io.mgba.mGBA ${workspaceFolder}/Astrolabe.elf &"
					}
				]
			},
			"preLaunchTask": "make",
		},
		{
			"name": "(gdb) Launch",
